<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${pageTitle != null ? pageTitle : 'E-Manager – E-Commerce Product & Order Management Platform'}</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body>

<!-- Top Announcement Banner -->
<div class="top-notice">
    <div>
        ✨ <strong>E-Manager Platform:</strong> Explore 30+ curated products across Electronics, Fashion & Home.
    </div>
    <div>
        <span>🚚 Free Express Shipping across India &nbsp;|&nbsp; 🔒 Simulated Secure Checkout</span>
    </div>
</div>

<!-- Main Sticky Navigation Bar -->
<header class="navbar">
    <a class="brand-wrapper" href="${pageContext.request.contextPath}/">
        <div class="brand-logo-icon">E</div>
        <div class="brand">
            <span>E-Manager</span>
            <span class="brand-sub">Storefront</span>
        </div>
    </a>

    <nav class="nav-center">
        <a href="${pageContext.request.contextPath}/" class="${pageContext.request.servletPath == '/index.jsp' ? 'active' : ''}">Home</a>
        <a href="${pageContext.request.contextPath}/products" class="${pageContext.request.servletPath == '/products.jsp' ? 'active' : ''}">All Products</a>
        <a href="${pageContext.request.contextPath}/products?categoryId=1">Electronics</a>
        <a href="${pageContext.request.contextPath}/products?categoryId=2">Fashion</a>
        <a href="${pageContext.request.contextPath}/products?categoryId=3">Home & Living</a>
        <a href="${pageContext.request.contextPath}/products?categoryId=4">Accessories</a>
    </nav>

    <div class="nav-right">
        <!-- Cart with Live Count Badge -->
        <a class="cart-pill" href="${pageContext.request.contextPath}/cart">
            🛒 <span>Cart</span>
            <span class="cart-badge">${sessionScope.cart != null ? sessionScope.cart.size() : 0}</span>
        </a>

        <!-- Account / Authentication -->
        <c:choose>
            <c:when test="${not empty sessionScope.customer}">
                <a class="btn outline small" href="${pageContext.request.contextPath}/orders">📦 My Orders</a>
                <c:if test="${sessionScope.isAdmin}">
                    <a class="btn accent small" href="${pageContext.request.contextPath}/admin/dashboard">⚙️ Admin</a>
                </c:if>
                <div class="user-tag">
                    👤 <span>${sessionScope.customer.fullName}</span>
                    <c:if test="${sessionScope.isAdmin}">
                        <span class="admin-badge">Admin</span>
                    </c:if>
                </div>
                <a class="btn outline small" href="${pageContext.request.contextPath}/customer?action=logout">Logout</a>
            </c:when>
            <c:otherwise>
                <a class="btn outline small" href="${pageContext.request.contextPath}/login.jsp">Sign In</a>
                <a class="btn small" href="${pageContext.request.contextPath}/register.jsp">Register</a>
            </c:otherwise>
        </c:choose>
    </div>
</header>

<main class="container">
