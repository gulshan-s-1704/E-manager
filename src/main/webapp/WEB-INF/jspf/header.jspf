<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>${pageTitle != null ? pageTitle : 'E-Manager – Modern E-Commerce Platform'}</title>
    
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Primary Professional Stylesheet with Cache-Buster -->
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css?v=20261118_v7">
</head>
<body>

<!-- Top Announcement Banner -->
<div class="top-notice">
    <div class="notice-main">
        ✨ <strong>E-Manager Platform:</strong> Curated collection of 30+ premium products across Electronics, Fashion &amp; Home.
    </div>
    <div class="notice-sub">
        <span>🚚 Free Express Shipping across India &nbsp;|&nbsp; 🔒 Simulated Secure Checkout</span>
    </div>
</div>

<!-- Main Sticky Navigation Bar -->
<header class="navbar">
    <div class="navbar-container">
        <!-- Brand Wrapper -->
        <a class="brand-wrapper" href="${pageContext.request.contextPath}/">
            <div class="brand-logo-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
            </div>
            <div class="brand">
                <span class="brand-title">E-Manager</span>
                <span class="brand-sub">Storefront</span>
            </div>
        </a>

        <!-- Desktop Navigation Links (hidden on <= 992px) -->
        <nav class="nav-center">
            <a href="${pageContext.request.contextPath}/" class="${pageContext.request.servletPath == '/index.jsp' ? 'active' : ''}">Home</a>
            <a href="${pageContext.request.contextPath}/products" class="${pageContext.request.servletPath == '/products.jsp' ? 'active' : ''}">All Products</a>
            <a href="${pageContext.request.contextPath}/products?categoryId=1">Electronics</a>
            <a href="${pageContext.request.contextPath}/products?categoryId=2">Fashion</a>
            <a href="${pageContext.request.contextPath}/products?categoryId=3">Home &amp; Living</a>
            <a href="${pageContext.request.contextPath}/products?categoryId=4">Accessories</a>
        </nav>

        <!-- Right Side: Cart, Auth, Hamburger Toggle -->
        <div class="nav-right">
            <!-- Cart with Live Count Badge -->
            <a class="cart-pill" href="${pageContext.request.contextPath}/cart" title="Shopping Cart">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span class="cart-label">Cart</span>
                <span class="cart-badge">${sessionScope.cart != null ? sessionScope.cart.size() : 0}</span>
            </a>

            <!-- Desktop Auth Controls (hidden on mobile <= 640px) -->
            <div class="desktop-auth">
                <c:choose>
                    <c:when test="${not empty sessionScope.customer}">
                        <a class="btn outline small" href="${pageContext.request.contextPath}/orders">📦 My Orders</a>
                        <c:if test="${sessionScope.isAdmin}">
                            <a class="btn accent small" href="${pageContext.request.contextPath}/admin/dashboard">⚙️ Admin</a>
                        </c:if>
                        <div class="user-tag">
                            <span>👤 ${sessionScope.customer.fullName}</span>
                            <c:if test="${sessionScope.isAdmin}">
                                <span class="admin-badge">Admin</span>
                            </c:if>
                        </div>
                        <a class="btn outline small" href="${pageContext.request.contextPath}/customer?action=logout">Logout</a>
                    </c:when>
                    <c:otherwise>
                        <a class="btn outline small" href="${pageContext.request.contextPath}/login.jsp">Sign In</a>
                        <a class="btn small" href="${pageContext.request.contextPath}/register.jsp">Register</a>
                    </c:otherwise>
                </c:choose>
            </div>

            <!-- Mobile Auth Quick Action (<= 640px) -->
            <div class="mobile-auth-quick">
                <c:choose>
                    <c:when test="${not empty sessionScope.customer}">
                        <a class="mobile-user-btn" href="${pageContext.request.contextPath}/orders" title="My Account">
                            👤
                        </a>
                    </c:when>
                    <c:otherwise>
                        <a class="btn outline xsmall mobile-signin-pill" href="${pageContext.request.contextPath}/login.jsp">Sign In</a>
                    </c:otherwise>
                </c:choose>
            </div>

            <!-- Mobile Hamburger Menu Button (visible on <= 992px) -->
            <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Open Navigation Menu" onclick="toggleMobileNav()">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </button>
        </div>
    </div>

    <!-- Mobile Slide-Down Navigation Drawer (<= 992px) -->
    <div class="mobile-nav-drawer" id="mobileNavDrawer">
        <div class="mobile-nav-inner">
            <div class="mobile-nav-heading">Store Categories</div>
            <a href="${pageContext.request.contextPath}/" class="mobile-nav-item ${pageContext.request.servletPath == '/index.jsp' ? 'active' : ''}">
                <span class="nav-icon">🏠</span> <span>Home</span>
            </a>
            <a href="${pageContext.request.contextPath}/products" class="mobile-nav-item ${pageContext.request.servletPath == '/products.jsp' && empty param.categoryId ? 'active' : ''}">
                <span class="nav-icon">🛍️</span> <span>All Products</span>
            </a>
            <a href="${pageContext.request.contextPath}/products?categoryId=1" class="mobile-nav-item ${param.categoryId == '1' ? 'active' : ''}">
                <span class="nav-icon">🎧</span> <span>Electronics &amp; Audio</span>
            </a>
            <a href="${pageContext.request.contextPath}/products?categoryId=2" class="mobile-nav-item ${param.categoryId == '2' ? 'active' : ''}">
                <span class="nav-icon">👕</span> <span>Fashion &amp; Apparel</span>
            </a>
            <a href="${pageContext.request.contextPath}/products?categoryId=3" class="mobile-nav-item ${param.categoryId == '3' ? 'active' : ''}">
                <span class="nav-icon">🪴</span> <span>Home &amp; Lifestyle</span>
            </a>
            <a href="${pageContext.request.contextPath}/products?categoryId=4" class="mobile-nav-item ${param.categoryId == '4' ? 'active' : ''}">
                <span class="nav-icon">💼</span> <span>Accessories &amp; Utility</span>
            </a>

            <div class="mobile-nav-divider"></div>
            <div class="mobile-nav-heading">Account &amp; Orders</div>

            <c:choose>
                <c:when test="${not empty sessionScope.customer}">
                    <div class="mobile-user-box">
                        <div style="font-weight:700; color:var(--slate-900);">👤 ${sessionScope.customer.fullName}</div>
                        <div style="font-size:0.78rem; color:var(--text-muted);">${sessionScope.customer.email}</div>
                    </div>
                    <a href="${pageContext.request.contextPath}/orders" class="mobile-nav-item">
                        <span class="nav-icon">📦</span> <span>My Order History</span>
                    </a>
                    <a href="${pageContext.request.contextPath}/cart" class="mobile-nav-item">
                        <span class="nav-icon">🛒</span> <span>Shopping Cart (${sessionScope.cart != null ? sessionScope.cart.size() : 0})</span>
                    </a>
                    <c:if test="${sessionScope.isAdmin}">
                        <a href="${pageContext.request.contextPath}/admin/dashboard" class="mobile-nav-item" style="color:var(--accent);">
                            <span class="nav-icon">⚙️</span> <span>Admin Management Portal</span>
                        </a>
                    </c:if>
                    <a href="${pageContext.request.contextPath}/customer?action=logout" class="mobile-nav-item" style="color:var(--danger);">
                        <span class="nav-icon">🚪</span> <span>Sign Out</span>
                    </a>
                </c:when>
                <c:otherwise>
                    <div class="mobile-auth-actions">
                        <a class="btn outline" href="${pageContext.request.contextPath}/login.jsp" style="flex:1; text-align:center;">Sign In</a>
                        <a class="btn accent" href="${pageContext.request.contextPath}/register.jsp" style="flex:1; text-align:center;">Register</a>
                    </div>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>

<script>
function toggleMobileNav() {
    var drawer = document.getElementById('mobileNavDrawer');
    var btn = document.getElementById('mobileMenuToggle');
    if (drawer && btn) {
        var isOpen = drawer.classList.contains('open');
        if (isOpen) {
            drawer.classList.remove('open');
            btn.classList.remove('active');
        } else {
            drawer.classList.add('open');
            btn.classList.add('active');
        }
    }
}
</script>

<main class="container">
